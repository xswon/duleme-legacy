# Optional default AI endpoint. Users can override this in Settings > AI 与转录.
# The endpoint must implement the OpenAI-compatible /chat/completions API.
AI_BASE_URL=""
AI_API_KEY=""
AI_MODEL=""

# Local development server port. Defaults to 4387.
PORT="4387"
# Vite hot-reload websocket port. Defaults to 4388.
HMR_PORT="4388"

# Opt in only when a local proxy/VPN uses 198.18.0.0/15 synthetic DNS answers.
ALLOW_PROXY_SYNTHETIC_DNS="false"
# Optional explicit proxy for outbound RSS, media, transcription, and AI requests.
# Unlike browser/system proxy settings, this is consumed directly by the Node server.
OUTBOUND_PROXY_URL=""

# Optional local NextEcho integration. When omitted, WReader discovers the
# sibling Podcast/NextEcho project in the standard workspace layout.
NEXTECHO_ROOT=""
# Override only when NextEcho listens somewhere other than 127.0.0.1:8765.
NEXTECHO_URL="http://127.0.0.1:8765"

# Optional public application URL.
APP_URL=""

# Enable the local advanced editor for optional enrichment feeds.
VITE_ENABLE_ENRICHMENT_SOURCE_EDITOR="false"
