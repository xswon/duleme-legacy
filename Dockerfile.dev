FROM node:22-bookworm-slim

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci
# npm can skip platform-specific optional packages when the lockfile was
# generated on macOS. The development image currently targets Linux ARM64.
RUN npm install --no-save --package-lock=false @rollup/rollup-linux-arm64-gnu@4.62.4

COPY . .

ENV NODE_ENV=development
ENV PORT=4387
ENV HMR_PORT=4388
ENV DOCKER=true

EXPOSE 4387 4388

CMD ["sh", "./scripts/docker-dev-entrypoint.sh"]
