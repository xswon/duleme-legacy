{
  "name": "duleme",
  "private": true,
  "version": "0.1.0-beta.2",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "tsx server-entry.ts",
    "build": "vite build && esbuild server-entry.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "build:desktop-main": "esbuild electron/main.mjs --bundle --platform=node --format=cjs --packages=external --external:electron --sourcemap --outfile=dist-electron/main.cjs",
    "build:desktop": "npm run build && npm run build:desktop-main",
    "desktop:dev": "npm run build:desktop && npx --yes electron@44.4.3 .",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "perf:50k": "tsx scripts/perf50k.ts",
    "typecheck": "tsc --noEmit",
    "check:bundle": "tsx scripts/checkBundleSize.ts",
    "check:architecture": "tsx scripts/checkArchitecture.ts",
    "verify": "npm run typecheck && npm run lint && npm run test:coverage && npm run build && npm run build:desktop-main && npm run check:bundle && npm run check:architecture",
    "clean": "rm -rf dist dist-electron release server.js",
    "lint": "eslint . --max-warnings=0",
    "desktop:dist": "npm run build:desktop && npx --yes electron-builder@26.16.1 --config electron-builder.yml --mac --publish never"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@tanstack/react-virtual": "^3.14.13",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "fast-xml-parser": "^5.10.1",
    "lucide-react": "^0.546.0",
    "marked": "^18.0.9",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "undici": "^8.10.0",
    "vite": "^6.2.3",
    "dompurify": "3.4.14"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^3.2.7",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.0.0",
    "globals": "^17.12.0",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.70.1",
    "vite": "^6.2.3",
    "vitest": "^3.2.4"
  },
  "description": "本地优先的 RSS 阅读器",
  "author": "xswon"
}
